flowchart TB
    ENTRY["API / CLI"]

    subgraph AUTH["DETERMINISTIC AUTHORITY"]
        direction TB
        KNOWLEDGE["Knowledge<br/>immutable claims · evidence · failure memory"]
        SNAPSHOT["CapabilitySnapshot<br/>datasets · policies · ordered providers"]
        GENERATION["Generation Service<br/>claim pins · typed JSON validation · replay"]
        COMPILER["Strategy Compiler<br/>schema · operator allowlist"]
        SEARCH["Finite Deterministic Search<br/>canonical identities · frozen parent pools · trial ledger"]
        LABS["8 Domain Labs / Engines<br/>Factor · StatArb · Market Making · Structural Flow<br/>Cross Venue · Derivatives · Event Fundamental · Time Series"]
        VALIDATION["Validation<br/>hard gates · purged/embargoed walk-forward"]
        PBO["PBO<br/>complete trial-ledger certificate"]
        HOLDOUT["Sealed Holdout<br/>automatic pre-access atomic consumption · lineage closure"]
        PUBLICATION["Publication<br/>atomic PUBLISHED visibility"]
        REPORT["ResearchReport<br/>canonical JSON · deterministic HTML"]

        KNOWLEDGE --> GENERATION
        SNAPSHOT --> GENERATION
        GENERATION --> COMPILER
        COMPILER --> SEARCH
        SEARCH --> LABS
        LABS --> VALIDATION
        VALIDATION --> PBO
        PBO --> HOLDOUT
        HOLDOUT --> PUBLICATION
        PUBLICATION --> REPORT
    end

    subgraph LLM_BOUNDARY["UNTRUSTED LLM BOUNDARY"]
        direction TB
        LLM_GENERATOR["LLM Candidate Generator<br/>untrusted typed JSON only"]
    end

    ENTRY --> GENERATION
    GENERATION -.->|snapshotted constrained request| LLM_GENERATOR
    LLM_GENERATOR -.->|untrusted candidate| GENERATION

